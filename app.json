{
  "expo": {
    "name": "Auto-Guardian-Taller",
    "slug": "Auto-Guardian-Taller",
    "version": "1.0.0",
    "orientation": "default",
    "icon": "./assets/icon-dark.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.trenkit.auto_guardian_taller",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon-dark.png",
        "backgroundColor": "#09111a"
      }
    },
    "web": {
      "favicon": "./assets/favicon-dark.png"
    },
    "extra": {
      "eas": {
        "projectId": "a9133971-532c-4b80-a826-7975c7a6a619"
      }
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "Auto-Guardian usa la cámara para adjuntar fotos del trabajo a las órdenes.",
          "photosPermission": "Auto-Guardian accede a tus fotos para adjuntarlas a las órdenes."
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-dark.png",
          "resizeMode": "contain",
          "backgroundColor": "#09111a"
        }
      ]
    ]
  }
}
